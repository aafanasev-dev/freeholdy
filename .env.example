BASE_DOMAIN=your_domain.com
DATA_DIR=data
NGINX_CONFIGS_DIR=nginx_configs
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
PROJECTS_DIR=projects
PLUGINS_DIR=plugins
PORT_RANGE_START=8100
PORT_RANGE_END=9000
CERTBOT_EMAIL=admin@your_domain.com
HOST=0.0.0.0
PORT=8000

# ── Backup destinations (optional) ────────────────────────────────────────────
# Named targets for automatic and manual backups. The database stores only the NAME;
# credentials live here and never reach the API, the web UI or a backup archive.
# Declare as many as you like; `fhcli backup-targets` lists them.
#
# rsync over ssh (the key is a path on this server):
# BACKUP_TARGET_offsite_TYPE=rsync
# BACKUP_TARGET_offsite_HOST=backup.example.com
# BACKUP_TARGET_offsite_USER=freeholdy
# BACKUP_TARGET_offsite_SSH_KEY=/root/.ssh/backup_ed25519
# BACKUP_TARGET_offsite_PATH=/srv/backups
#
# FTP (use TYPE=ftps, or TLS=true, for an encrypted control channel):
# BACKUP_TARGET_ftpbox_TYPE=ftp
# BACKUP_TARGET_ftpbox_HOST=ftp.example.com
# BACKUP_TARGET_ftpbox_USER=someone
# BACKUP_TARGET_ftpbox_PASSWORD=secret
# BACKUP_TARGET_ftpbox_PATH=/backups
