# Shared SNI listener — generated by freeholdy. Do not edit manually.
# Exists only while at least one project routes by hostname (a map under sni/).
# The client's TLS ClientHello names the host; the map sends the still-encrypted
# connection to that project's TLS terminator (a unix socket, see freeholdy_{project}.conf).
# A client that does not open with TLS (e.g. a classic PostgreSQL SSLRequest) carries no
# SNI and falls through to the default, which refuses the connection.
map $ssl_preread_server_name $freeholdy_sni_backend {
    include {{ streams_dir }}/sni/*.map;
    default 127.0.0.1:1;
}

server {
    listen        {{ sni_port }};
    ssl_preread   on;
    proxy_pass    $freeholdy_sni_backend;
    proxy_timeout 24h;
}
