# Stream (TCP) config for {{ project }} — generated by freeholdy. Do not edit manually.
# Included inside nginx's stream {} block (scripts/setup_nginx_stream.sh).

{% for part in parts %}
{% if part.sni_active %}
# {{ part.subdomain }} — TLS terminated here with the Let's Encrypt cert; reached through
# the shared :{{ sni_port }} SNI listener (00-freeholdy-sni-listener.conf).
server {
    listen                 unix:{{ part.socket }} ssl;
    ssl_certificate        /etc/letsencrypt/live/{{ part.cert_name }}/fullchain.pem;
    ssl_certificate_key    /etc/letsencrypt/live/{{ part.cert_name }}/privkey.pem;
    ssl_protocols          TLSv1.2 TLSv1.3;
{% if part.alpn %}
    ssl_alpn               {{ part.alpn }};
{% endif %}
    proxy_pass             127.0.0.1:{{ part.local_port }};
    proxy_timeout          24h;
    proxy_socket_keepalive on;
}

{% endif %}
{% if part.public_port %}
# {{ part.subdomain }}:{{ part.public_port }} — plain TCP passthrough; the service does its own TLS.
server {
    listen                 {{ part.public_port }};
    proxy_pass             127.0.0.1:{{ part.local_port }};
    proxy_timeout          24h;
    proxy_socket_keepalive on;
}

{% endif %}
{% endfor %}
